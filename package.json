{
  "name": "jobs-checker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "sources:check": "node --import tsx scripts/check-sources.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:http": "node --import tsx scripts/check-http.ts",
    "mcp": "node --import tsx scripts/jobs-mcp.ts",
    "tools": "node --import tsx scripts/jobs-tool.ts",
    "test:mcp": "node --import tsx scripts/check-mcp.ts",
    "test:providers:live": "node --import tsx scripts/check-provider-tools.ts"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "he": "^1.2.0",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/he": "^1.2.3",
    "@types/node": "^24.3.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "prettier": "^3.9.8",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
