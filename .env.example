PORT=4317
# SQLite stays on this computer. Relative paths resolve from the project root.
SCOUT_DB=../data/jobs-checker/scout.sqlite
# Optional: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional meta-discovery: https://serpapi.com/
SERPAPI_API_KEY=
# Start/renewal timestamp from the SerpAPI account, including timezone.
# Without it, the local quota uses a conservative rolling 31-day window.
SERPAPI_BILLING_ANCHOR=
# Free plan defaults; adjust only to match your actual subscription.
SERPAPI_MONTHLY_LIMIT=250
SERPAPI_HOURLY_LIMIT=50
# Optional regional Jooble key. Set country to match the market that issued it.
JOOBLE_API_KEY=
JOOBLE_COUNTRY=
JOOBLE_HOST=jooble.org
# MCP/CLI connect to the running local app; keys stay in this file.
SCOUT_API_URL=http://127.0.0.1:4317
